{
  "name": "site-audit-ru",
  "version": "1.1.0",
  "description": "Аудит сайта и конкурентов: SEO, структура, визуальный стиль, технологии и соответствие законам РФ. CLI + плагин Claude Code.",
  "type": "module",
  "bin": {
    "site-audit-ru": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prompts",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs",
    "build:media": "npm run build && node scripts/build-media.mjs"
  },
  "keywords": [
    "seo",
    "audit",
    "site-audit",
    "152-fz",
    "claude-code",
    "plugin",
    "competitors",
    "ai-agent",
    "russian"
  ],
  "author": "Egor Kozhevnikov (https://github.com/kozhevnikovai)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kozhevnikovai/auditor-saitov.git"
  },
  "dependencies": {
    "@fontsource/geologica": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "playwright-core": "^1.65.0",
    "robots-parser": "^3.0.1",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
